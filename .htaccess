# --- SAFE BASELINE ---
Options -MultiViews

RewriteEngine On

DirectoryIndex index.php index.php index.html

RewriteRule ^uploads/ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule - [L]
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
