{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**/*.php"
    }
  },
  "routes": [
    {
      "src": "/api/assistant/?$",
      "dest": "/api/assistant/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php?__vercel_path=api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/api/index.php?__vercel_path=pages/$1"
    },
    {
      "src": "/index.php",
      "dest": "/api/index.php?__vercel_path=index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?__vercel_path=index.php"
    }
  ]
}